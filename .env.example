# ===== Voice: ElevenLabs first, Sarvam fallback (no local model) =====
# ElevenLabs  https://elevenlabs.io
ELEVEN_API_KEY=
ELEVEN_MODEL=eleven_multilingual_v2
# Voice used when a name isn't found on the account (Monika Sogam - Indian female)
ELEVEN_VOICE_ID=Ms9OTvWb99V6DwRHZn6q

# Sarvam  https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_LANGUAGE=en-IN
# Sarvam voice used when TTS_VOICE is an ElevenLabs-only name/id
SARVAM_VOICE=simran

# Engine order: TTS_ENGINE first, then TTS_FALLBACK (eleven | sarvam)
TTS_ENGINE=eleven
TTS_FALLBACK=sarvam
TTS_VOICE=Ms9OTvWb99V6DwRHZn6q

# ===== Google Gemini (planning, images, Veo video) =====
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
GEMINI_CHECK_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3-pro-image
# veo-3.1-fast-generate-preview (cheaper) | veo-3.1-generate-preview (best quality)
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_RESOLUTION=720p

# ===== Ad defaults =====
# Voiceover languages for every new ad: en, hi (one final video per language, same visuals)
UGC_LANGUAGES=en,hi
